# Copy to .env for docker-compose. Local development uses .envrc (+ .env.local) via direnv.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME
SITE_DOMAIN=jobs.example.org          # sign-in is served at auth.<SITE_DOMAIN>
DEFAULT_LOCALE=en
SCRAPER_USER_AGENT=IgniteJobBoardBot/0.1 (+https://jobs.example.org/about)

# Session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# FerrisKey (identity provider). Its data lives in a `ferriskey` database on the same server:
#   CREATE DATABASE ferriskey;
FERRISKEY_DB_HOST=host.docker.internal
FERRISKEY_DB_PORT=5432
FERRISKEY_DB_USER=
FERRISKEY_DB_PASSWORD=
FERRISKEY_ADMIN_PASSWORD=             # FerrisKey console login (user: admin)
FERRISKEY_ADMIN_EMAIL=
# Printed by `docker-compose run --rm migrate pnpm auth:bootstrap --print-env`.
OIDC_CLIENT_SECRET=

# Outgoing email for FerrisKey (password resets).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@jobs.example.org
SMTP_ENCRYPTION=starttls
