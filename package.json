{
  "name": "ignite-job-board",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ignite/db generate",
    "db:migrate": "pnpm --filter @ignite/db migrate",
    "db:seed": "pnpm --filter @ignite/db seed"
  }
}
